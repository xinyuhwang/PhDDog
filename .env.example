# "fake" runs offline with rule-based stand-ins (no API key, no cost).
# "claude" uses the Claude API and needs ANTHROPIC_API_KEY.
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=

# Used in the crawler's User-Agent and required by the Unpaywall API.
CONTACT_EMAIL=you@example.com

TARGET_CYCLE=Fall 2027

# Change if port 3000 is already in use on your machine.
FRONTEND_PORT=3000
